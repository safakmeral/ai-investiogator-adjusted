EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local Python analysis microservice (DeepFace + MediaPipe + librosa)
# Set this to the LAN IP of the machine running uvicorn (port 8001 by default)
EXPO_PUBLIC_PYTHON_SERVICE_URL=http://192.168.1.10:8001

# Edge Function Secrets (sadece Supabase Dashboard'da set edilir, .env'e konmaz)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
